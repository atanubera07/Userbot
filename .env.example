# Get your own API application credentials at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LIBRARY=telethon

# Login by phone in your terminal, or optionally provide your existing
# private session here. Its format must match TELEGRAM_LIBRARY (telethon/pyrogram).
# Leave blank for phone login locally. Hosting requires a session string.
TELEGRAM_SESSION_STRING=
# Optional local SQLite session path; never use a session running elsewhere.
# TELEGRAM_SESSION_FILE=/home/you/.hexa/hexa_userbot

HEXA_BOT_USERNAME=@HeXamonbot
# Optional extra identity check:
# HEXA_BOT_ID=

# .resume and --autostart use this initial mode. Commands can select either mode.
HEXA_MODE=battle

# Optional comma-separated numeric Telegram user IDs allowed to control this bot.
# The logged-in account always keeps access. Blank means owner only.
HEXA_SUDO_USERS=

# Original alert destination and recipient from your scripts.
# Set HEXA_NOTIFY_CHAT=me to receive alerts in Saved Messages instead.
HEXA_NOTIFY_CHAT=-1004490697963
HEXA_ALERT_TAG=@Kill_switch8

# Catch mode: Regular Ball, Great Ball, Ultra Ball, or Repeat Ball.
HEXA_BALL=Regular Ball
HEXA_DELAY=5
HEXA_HUNT_DELAY=1
HEXA_TIMEOUT=45
HEXA_MAX_THROWS=30
HEXA_MAX_ATTACKS=10
# Optional exact damaging move name, overriding the default choice in both modes.
HEXA_ATTACK_MOVE=
# Optional for hosts with a shared/persistent disk; Render Free has no disk.
# HEXA_LOCK_DIR=/var/data/hexa/locks
# Render supplies PORT automatically when running with --web.
# PORT=10000
